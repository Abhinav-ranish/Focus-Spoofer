{
  "name": "focus-spoofer",
  "private": true,
  "description": "Chrome extension that stops websites from detecting when you switch tabs or minimize the window.",
  "homepage": "https://focus.oddworks.us",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhinav-ranish/Focus-Spoofer.git"
  },
  "bugs": {
    "url": "https://github.com/Abhinav-ranish/Focus-Spoofer/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run build",
    "assets": "node store-assets/generate.mjs",
    "site:i18n": "node scripts/site-i18n.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.64.0"
  }
}
