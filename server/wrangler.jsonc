{
  // Cloudflare Worker serving the uninstall survey page, the survey endpoint,
  // the opt-in usage report endpoint, and a token-protected stats dashboard.
  // See ../docs/BACKEND.md for deployment steps.
  "name": "focus-spoofer-feedback",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "focus-spoofer",
      // Replace with the id printed by `npx wrangler d1 create focus-spoofer`.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Workers Rate Limiting API: counters live at the edge, keyed per client
  // address for the duration of the period only — nothing is persisted.
  "ratelimits": [
    { "name": "SURVEY_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "REPORT_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ]
  // Secret (not in this file): DASHBOARD_TOKEN — `npx wrangler secret put DASHBOARD_TOKEN`
  // Optional: only accept reports from the published extension ID(s).
  // "vars": { "EXTENSION_ORIGINS": "chrome-extension://ejgeaphjlcnmjgadkcljhchgbaiioihh" }
}
